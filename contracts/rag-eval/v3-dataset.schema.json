{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multimodal Textbook RAG V3 Evaluation Dataset",
  "type": "object",
  "required": ["dataset_id", "schema_version", "documents", "objects", "cases"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "rag-eval/v3"},
    "documents": {"type": "array", "minItems": 1},
    "objects": {"type": "array", "minItems": 1},
    "cases": {"type": "array", "minItems": 1}
  }
}
