{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multimodal Textbook RAG V3 Evaluation Dataset",
  "type": "object",
  "required": ["dataset_id", "schema_version", "documents", "objects", "cases"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "rag-eval/v3"},
    "documents": {"type": "array", "minItems": 1},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "bbox": {
            "description": "归一化 [x1, y1, x2, y2]；没有经验证的版面坐标时可省略或为 null。",
            "anyOf": [
              {"type": "null"},
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              }
            ]
          }
        }
      }
    },
    "cases": {"type": "array", "minItems": 1}
  }
}
