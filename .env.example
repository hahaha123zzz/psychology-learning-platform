APP_ENV=development
APP_NAME=Psychology Learning Platform
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO

POSTGRES_DB=psychology_learning
POSTGRES_USER=psychology
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://psychology:change-me@127.0.0.1:5432/psychology_learning

REDIS_URL=redis://127.0.0.1:6379/0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET=course-materials
MINIO_BROWSER_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_SECRET=dev-only-change-me-32-bytes-minimum-key!

# 外部模型留空时使用本地确定性测试替身。兼容 OpenAI Chat Completions 的供应商可在此切换。
LLM_PROVIDER=internal
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# 与 LLM_PROVIDER 使用同一家供应商；当前索引固定 384 维，切换模型后必须重新嵌入。
# 未配置 EMBEDDING_MODEL 时继续使用本地 hash-v1 测试替身。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT_SECONDS=30

# 低于该余弦相似度的向量最近邻不作为教材证据，避免无关问题被错误回答。
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.10

# 教材上传采用浏览器直传 MinIO 的可恢复分片；解析与索引由独立 Celery Worker 执行。
# 旧版教师直接上传/解析/索引/发布 API 在产品环境默认关闭；仅隔离工程诊断可显式启用。
MATERIAL_LEGACY_AUTHORING_API_ENABLED=false
UPLOAD_PART_SIZE_MB=8
UPLOAD_SESSION_TTL_HOURS=24
TASK_BACKEND=celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
TASK_HEARTBEAT_SECONDS=10
TASK_STALE_SECONDS=1800

NEXT_PUBLIC_APP_NAME=实验心理学智能学习平台
SERVER_API_BASE_URL=http://127.0.0.1:8000
